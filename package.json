{
  "name": "hailar-road-trip-guide",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run build && vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --test tests/app/*.browser.cjs",
    "test:app": "node --test tests/app/*.browser.cjs",
    "test:app:prod": "npm run build && APP_MODE=preview node --test tests/app/*.browser.cjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "~1.62.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0"
  }
}
