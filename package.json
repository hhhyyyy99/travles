{
  "name": "tibet-road-trip-guide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-guide.cjs && next dev",
    "build": "node scripts/prepare-guide.cjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.cjs",
    "export": "node scripts/prepare-guide.cjs && NEXT_EXPORT=true next build",
